<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured" jcr:title="Minimal Beauty Article" sling:resourceType="cq/gui/components/authoring/dialog">
  <content jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container">
    <items jcr:primaryType="nt:unstructured">
      <tabs jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/tabs" maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
          <contentTab jcr:primaryType="nt:unstructured" jcr:title="Content" sling:resourceType="granite/ui/components/coral/foundation/container">
            <items jcr:primaryType="nt:unstructured">
              <title jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Title" name="./title" required="{Boolean}true"/>
              <text jcr:primaryType="nt:unstructured" sling:resourceType="cq/gui/components/authoring/dialog/richtext" fieldLabel="Text" name="./text" useFixedInlineToolbar="{Boolean}true"/>
              <buttonText jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Button text" name="./buttonText"/>
              <buttonLink jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/pathfield" fieldLabel="Button link" rootPath="/content" name="./buttonLink"/>
            </items>
          </contentTab>
          <mediaTab jcr:primaryType="nt:unstructured" jcr:title="Image and layout" sling:resourceType="granite/ui/components/coral/foundation/container">
            <items jcr:primaryType="nt:unstructured">
              <image jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/pathfield" fieldLabel="Image" rootPath="/content/dam/intibiome" name="./image" required="{Boolean}true"/>
              <imageAlt jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield" fieldLabel="Alternative text" name="./imageAlt"/>
              <imagePosition jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Image position on desktop" name="./imagePosition">
                <items jcr:primaryType="nt:unstructured"><right jcr:primaryType="nt:unstructured" text="Right" value="right" selected="{Boolean}true"/><left jcr:primaryType="nt:unstructured" text="Left" value="left"/></items>
              </imagePosition>
              <theme jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Text block theme" name="./theme">
                <items jcr:primaryType="nt:unstructured"><dark jcr:primaryType="nt:unstructured" text="Dark" value="dark" selected="{Boolean}true"/><light jcr:primaryType="nt:unstructured" text="White" value="light"/><beige jcr:primaryType="nt:unstructured" text="Minimal beige" value="beige"/></items>
              </theme>
              <columnRatio jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Desktop column ratio" name="./columnRatio">
                <items jcr:primaryType="nt:unstructured"><half jcr:primaryType="nt:unstructured" text="50 / 50" value="half" selected="{Boolean}true"/><third jcr:primaryType="nt:unstructured" text="Image 33% / Text 67%" value="third"/></items>
              </columnRatio>
              <height jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Minimum height" name="./height">
                <items jcr:primaryType="nt:unstructured"><content jcr:primaryType="nt:unstructured" text="According to content" value="content"/><standard jcr:primaryType="nt:unstructured" text="Standard" value="standard" selected="{Boolean}true"/><tall jcr:primaryType="nt:unstructured" text="Tall" value="tall"/></items>
              </height>
              <spacing jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Text spacing" name="./spacing">
                <items jcr:primaryType="nt:unstructured"><compact jcr:primaryType="nt:unstructured" text="Compact" value="compact"/><standard jcr:primaryType="nt:unstructured" text="Standard" value="standard" selected="{Boolean}true"/><roomy jcr:primaryType="nt:unstructured" text="Roomy" value="roomy"/></items>
              </spacing>
              <titleStyle jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Title capitalization" name="./titleStyle">
                <items jcr:primaryType="nt:unstructured"><original jcr:primaryType="nt:unstructured" text="As authored" value="original"/><uppercase jcr:primaryType="nt:unstructured" text="Uppercase" value="uppercase" selected="{Boolean}true"/></items>
              </titleStyle>
              <focalPoint jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Image focal point" name="./focalPoint">
                <items jcr:primaryType="nt:unstructured"><leftTop jcr:primaryType="nt:unstructured" text="Left top" value="left-top"/><centerTop jcr:primaryType="nt:unstructured" text="Center top" value="center-top"/><rightTop jcr:primaryType="nt:unstructured" text="Right top" value="right-top"/><leftCenter jcr:primaryType="nt:unstructured" text="Left center" value="left-center"/><centerCenter jcr:primaryType="nt:unstructured" text="Center" value="center-center" selected="{Boolean}true"/><rightCenter jcr:primaryType="nt:unstructured" text="Right center" value="right-center"/><leftBottom jcr:primaryType="nt:unstructured" text="Left bottom" value="left-bottom"/><centerBottom jcr:primaryType="nt:unstructured" text="Center bottom" value="center-bottom"/><rightBottom jcr:primaryType="nt:unstructured" text="Right bottom" value="right-bottom"/></items>
              </focalPoint>
            </items>
          </mediaTab>
        </items>
      </tabs>
    </items>
  </content>
</jcr:root>
