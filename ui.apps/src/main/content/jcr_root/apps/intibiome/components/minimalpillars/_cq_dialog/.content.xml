<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured" jcr:title="Minimal Beauty Pillars"
    sling:resourceType="cq/gui/components/authoring/dialog">
  <content jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container">
    <items jcr:primaryType="nt:unstructured">
      <title jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
          fieldLabel="Section title" name="./title"
          emptyText="OS TRÊS PILARES MINIMAL"/>
      <pillars jcr:primaryType="nt:unstructured"
          sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
          composite="{Boolean}true" fieldLabel="Pillars">
        <field jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/container" name="./items">
          <items jcr:primaryType="nt:unstructured">
            <image jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Image" name="./image" rootPath="/content/dam/intibiome"
                required="{Boolean}true"/>
            <imageAlt jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Alternative text" name="./imageAlt" required="{Boolean}true"/>
            <title jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                fieldLabel="Pillar title" name="./title" required="{Boolean}true"/>
            <link jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                fieldLabel="Link (optional)" name="./link" rootPath="/content"/>
          </items>
        </field>
      </pillars>
    </items>
  </content>
</jcr:root>
