<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Minimal Beauty Banner"
    sling:resourceType="cq/gui/components/authoring/dialog">
  <content jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/container">
    <items jcr:primaryType="nt:unstructured">
      <tabs jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/tabs" maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
          <contentTab jcr:primaryType="nt:unstructured" jcr:title="Content" sling:resourceType="granite/ui/components/coral/foundation/container" margin="{Boolean}true">
            <items jcr:primaryType="nt:unstructured">
              <image jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                  fieldLabel="Image" rootPath="/content/dam/intibiome" name="./image" required="{Boolean}true"/>
              <imageAlt jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                  fieldLabel="Alternative text" name="./imageAlt" required="{Boolean}true"/>
              <title jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                  fieldLabel="Title" name="./title" required="{Boolean}true"/>
              <headingLevel jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select"
                  fieldLabel="Heading level" fieldDescription="Use H1 only for the main banner of the page." name="./headingLevel">
                <items jcr:primaryType="nt:unstructured">
                  <h1 jcr:primaryType="nt:unstructured" text="H1 - Main page heading" value="h1"/>
                  <h2 jcr:primaryType="nt:unstructured" text="H2 - Section heading" value="h2" selected="{Boolean}true"/>
                </items>
              </headingLevel>
            </items>
          </contentTab>
          <layoutTab jcr:primaryType="nt:unstructured" jcr:title="Layout" sling:resourceType="granite/ui/components/coral/foundation/container" margin="{Boolean}true">
            <items jcr:primaryType="nt:unstructured">
              <alignment jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Text alignment" name="./alignment">
                <items jcr:primaryType="nt:unstructured">
                  <center jcr:primaryType="nt:unstructured" text="Center" value="center" selected="{Boolean}true"/>
                  <left jcr:primaryType="nt:unstructured" text="Left" value="left"/>
                  <right jcr:primaryType="nt:unstructured" text="Right" value="right"/>
                </items>
              </alignment>
              <textColor jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Text color" name="./textColor">
                <items jcr:primaryType="nt:unstructured">
                  <light jcr:primaryType="nt:unstructured" text="Light" value="light" selected="{Boolean}true"/>
                  <dark jcr:primaryType="nt:unstructured" text="Dark" value="dark"/>
                </items>
              </textColor>
              <overlay jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Image overlay" name="./overlay">
                <items jcr:primaryType="nt:unstructured">
                  <none jcr:primaryType="nt:unstructured" text="None" value="none"/>
                  <soft jcr:primaryType="nt:unstructured" text="Soft" value="soft"/>
                  <medium jcr:primaryType="nt:unstructured" text="Medium" value="medium" selected="{Boolean}true"/>
                  <strong jcr:primaryType="nt:unstructured" text="Strong" value="strong"/>
                </items>
              </overlay>
              <height jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Banner height" name="./height">
                <items jcr:primaryType="nt:unstructured">
                  <compact jcr:primaryType="nt:unstructured" text="Compact" value="compact"/>
                  <standard jcr:primaryType="nt:unstructured" text="Standard" value="standard" selected="{Boolean}true"/>
                  <tall jcr:primaryType="nt:unstructured" text="Tall" value="tall"/>
                </items>
              </height>
              <focalPoint jcr:primaryType="nt:unstructured" sling:resourceType="granite/ui/components/coral/foundation/form/select" fieldLabel="Image focal point" name="./focalPoint">
                <items jcr:primaryType="nt:unstructured">
                  <leftTop jcr:primaryType="nt:unstructured" text="Left top" value="left-top"/>
                  <centerTop jcr:primaryType="nt:unstructured" text="Center top" value="center-top"/>
                  <rightTop jcr:primaryType="nt:unstructured" text="Right top" value="right-top"/>
                  <leftCenter jcr:primaryType="nt:unstructured" text="Left center" value="left-center"/>
                  <centerCenter jcr:primaryType="nt:unstructured" text="Center" value="center-center" selected="{Boolean}true"/>
                  <rightCenter jcr:primaryType="nt:unstructured" text="Right center" value="right-center"/>
                  <leftBottom jcr:primaryType="nt:unstructured" text="Left bottom" value="left-bottom"/>
                  <centerBottom jcr:primaryType="nt:unstructured" text="Center bottom" value="center-bottom"/>
                  <rightBottom jcr:primaryType="nt:unstructured" text="Right bottom" value="right-bottom"/>
                </items>
              </focalPoint>
            </items>
          </layoutTab>
        </items>
      </tabs>
    </items>
  </content>
</jcr:root>
